<mxfile host="Electron">
  <diagram id="HvCplBdI5Jjl0Vf-fzOM" name="Page-1">
    <mxGraphModel dx="4010" dy="2236" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant Client\n    participant Handler as SingleFieldSearchHandler\n    participant Tokenizer as LocationTokenizer\n    participant Factory as SearchTaskFactory\n    participant InitBuilder as InitialSearchTaskBuilder\n    participant Result as SearchResult\n    participant Task as SearchTask\n    participant Invoker as GeosupportInvoker\n    participant StatusReader as ResponseStatusReader\n    participant Policy as SearchPolicy\n    participant ExactPolicy as ExactMatchPolicy\n    participant DepthPolicy as SearchDepthPolicy\n    participant SpawnBuilder as SpawnedSearchTaskBuilder\n\n    Client-&gt;&gt;Handler: findLocation(searchPolicy, inputString)\n    Handler-&gt;&gt;Tokenizer: parse(input)\n    Tokenizer--&gt;&gt;Handler: locationTokens\n\n    Handler-&gt;&gt;Handler: doInitialSearch(searchPolicy, locationTokens)\n    activate Handler\n    Handler-&gt;&gt;Factory: buildInitialSearchTasks(searchPolicy, locationTokens)\n    Factory-&gt;&gt;InitBuilder: getSearchTasks(searchPolicy, locationTokens)\n    InitBuilder--&gt;&gt;Factory: List&lt;SearchTask&gt;\n    Factory--&gt;&gt;Handler: List&lt;SearchTask&gt;\n\n    Handler-&gt;&gt;Result: new SearchResult(searchPolicy, locationTokens)\n    activate Result\n    Result--&gt;&gt;Handler: searchResult\n\n    Handler-&gt;&gt;Handler: doSearches(searchResult, searchTasks)\n    activate Handler\n    loop for each SearchTask\n        Handler-&gt;&gt;Handler: doSearch(searchTask)\n        activate Handler\n        Handler-&gt;&gt;Task: executorService.submit(searchTask) -&gt; call()\n        activate Task\n        Task-&gt;&gt;Task: doCall()\n        Task-&gt;&gt;Invoker: invoke Geosupport function\n        Invoker--&gt;&gt;Task: result map\n        Task-&gt;&gt;StatusReader: read(actualResult)\n        StatusReader--&gt;&gt;Task: responseStatus\n        Task--&gt;&gt;Handler: new Search(request, response)\n        deactivate Task\n        Handler--&gt;&gt;Handler: search\n        deactivate Handler\n        Handler-&gt;&gt;Result: add(search)\n        Result--&gt;&gt;Result: update currentLevel\n    end\n    deactivate Handler\n    Handler--&gt;&gt;Handler: searchResult populated\n    deactivate Handler\n    deactivate Result\n\n    Handler-&gt;&gt;Result: isExactMatch()\n    Result-&gt;&gt;Policy: findExactMatch(searchResult)\n    Policy-&gt;&gt;ExactPolicy: findExactMatch(searchResult)\n    ExactPolicy--&gt;&gt;Policy: Search or null\n    Policy--&gt;&gt;Result: Search or null\n    Result--&gt;&gt;Handler: true/false\n\n    alt exact match found\n        Handler--&gt;&gt;Client: return searchResult\n    else no exact match\n        loop while sub-searches exist and no exact match\n            Handler-&gt;&gt;Handler: doSubSearches(searchResult)\n            activate Handler\n            Handler-&gt;&gt;Factory: buildSubsearchTasks(searchResult)\n            Factory-&gt;&gt;SpawnBuilder: getSearchTasks(searchResult)\n            SpawnBuilder--&gt;&gt;Factory: List&lt;SearchTask&gt;\n            Factory--&gt;&gt;Handler: List&lt;SearchTask&gt;\n            Handler-&gt;&gt;Handler: doSearches(searchResult, subSearches)\n            Note over Handler,Result: Same per-task flow as initial search:&lt;br/&gt;submit to executor, call(), doCall(),&lt;br/&gt;read status, new Search, result.add()\n            Handler-&gt;&gt;Result: isExactMatch()\n            Result-&gt;&gt;Policy: findExactMatch(searchResult)\n            Policy-&gt;&gt;DepthPolicy: inputForSubSearches(searchResult) [next iteration check]\n            deactivate Handler\n        end\n        Handler--&gt;&gt;Client: return searchResult\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="79">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
